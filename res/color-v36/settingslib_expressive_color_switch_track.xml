<?xml version="1.0" encoding="utf-8"?>
<!--
     Copyright 2026 TextGavel. Licensed under the Apache License, Version 2.0.
     Cyclon Glass: the kit's switch track (components.css .switch), as in Settings: the primary (white in dark,
     black in light) when on, the translucent switch-off grey when off, never the owner's highlight. Overrides
     SettingsLib's.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.38"
        android:color="@color/glass_switch_off"
        android:state_enabled="false" android:state_checked="false"/>
    <item
        android:alpha="0.38"
        android:color="@color/glass_primary"
        android:state_enabled="false" android:state_checked="true"/>
    <item
        android:color="@color/glass_primary"
        android:state_checked="true"/>
    <item
        android:color="@color/glass_switch_off"/>
</selector>
