     Cyclon Glass: the kit's switch knob (components.css .switch::after), as in Settings: white on the grey track
     when off, the on-primary colour on the primary track when on. Overrides SettingsLib's.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.38"
        android:color="@color/glass_knob"
        android:state_enabled="false" android:state_checked="false"/>
    <item
        android:color="@color/glass_on_primary"
        android:state_enabled="false" android:state_checked="true"/>
    <item
        android:color="@color/glass_on_primary"
        android:state_checked="true"/>
    <item
        android:color="@color/glass_knob"/>
</selector>
