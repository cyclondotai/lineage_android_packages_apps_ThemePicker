<!--
     Copyright 2026 TextGavel. Licensed under the Apache License, Version 2.0.
     Cyclon Glass, as on Settings' pages: Wallpaper & style's options (Clock, Shortcuts, Notifications on lock screen,
     ...) are one frosted card per group (components.css .list), the library's card slices (glass_card_*_open, which
     reach 1dp past the row where it meets the next one; the options' LinearLayout clips them, so the group has one
     edge around it), with a hairline between two options from where their words start to the card's end edge.
     The first option of a group: the card's top, with a hairline under it.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:topLeftRadius="@dimen/glass_list_radius" android:topRightRadius="@dimen/glass_list_radius" />
        </shape>
    </item>
    <item android:drawable="@drawable/glass_card_top_open" />
    <item
        android:gravity="bottom|fill_horizontal"
        android:height="@dimen/cyclon_glass_row_hair"
        android:start="@dimen/customization_option_entry_horizontal_padding">
        <color android:color="@color/glass_hair" />
    </item>
</ripple>
