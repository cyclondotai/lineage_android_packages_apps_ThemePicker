<!-- Cyclon Glass, as on Settings' pages: WallpaperPicker2's picker toolbar with Home's back pill (components.css
     .back-pill, Settings' layout/cyclon_glass_back_pill) in place of the round close/back key: the frosted key fill
     and edge (glass_btn), 44dp tall, the chevron 8dp in, the word "Back" 2dp after it and 18dp before the end.
     DefaultToolbarBinder still finds nav_button (a FrameLayout, which goes back) and nav_button_icon (a View whose
     foreground it sets to ic_arrow_back_24dp or ic_close_24dp, both the chevron here, and whose background it tints:
     a transparent shape, so the pill's fill shows). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar_container"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/customization_toolbar_vertical_padding"
    android:gravity="center_vertical">
    <FrameLayout
        android:id="@+id/nav_button"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/glass_control_height"
        android:layout_marginStart="@dimen/glass_list_margin"
        android:background="@drawable/glass_btn"
        android:contentDescription="@string/bottom_action_bar_back">
        <View
            android:id="@+id/nav_button_icon"
            android:layout_height="@dimen/cyclon_glass_back_icon"
            android:layout_width="@dimen/cyclon_glass_back_icon"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/cyclon_glass_back_padding_start"
            android:background="@drawable/cyclon_glass_back_icon_background"
            android:foregroundGravity="center"
            android:foreground="@drawable/ic_close_24dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/cyclon_glass_back_text_start"
            android:layout_marginEnd="@dimen/cyclon_glass_back_padding_end"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/cyclon_glass_back"
            android:textAppearance="@style/TextAppearance.CyclonGlass.BackPill"
            android:fontFamily="@font/glass_geist"
            android:textFontWeight="500" />
    </FrameLayout>

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?android:attr/actionBarSize"
        style="@style/ToolbarTheme"
        android:importantForAccessibility="yes"
        android:layout_gravity="top"
        android:layout_weight="1"/>

    <com.android.wallpaper.picker.customization.ui.view.ApplyButton
        android:id="@+id/apply_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min_height"
        android:layout_marginEnd="@dimen/apply_button_end_margin" />
</LinearLayout>
